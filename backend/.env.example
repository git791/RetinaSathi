# ==============================================================================
# NetraMitra Backend Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION (Safe Defaults)
# ------------------------------------------------------------------------------

# MATLAB_MODE determines whether to use the mock service or the compiled MATLAB runtime.
# Allowed values: 'mock', 'compiled'
# Default: mock
MATLAB_MODE=mock

# CORS Origins allowed to communicate with this backend.
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Note: No MATLAB_API_KEY, MATLAB_COMPILED_PACKAGE_PATH, or MATLAB_RUNTIME_PATH 
# is needed. The 'retinasathimodel' is installed directly into the Python 
# environment via `pip install`, and it handles MATLAB Runtime resolution natively.

# Gemini AI Explanation Module
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EXPLANATION_ENABLED=true
